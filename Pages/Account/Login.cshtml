@page
@model myProducts.Pages.Account.LoginModel
@{
    Layout = "~/Pages/Shared/Auth/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";
}

@section AuthTitle {
            Login
}

<form method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error">
            <div asp-validation-summary="All"></div>
        </div>
    }
    <div>
        <input type="text"
                id="username"
                asp-for="Input.Username"
                placeholder="Usuário"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring @InputErrorClass("Input.Username")"
                required />
    </div>
    <div class="mt-2">
        <input type="password"
                id="password"
                asp-for="Input.Password"
                placeholder="Senha"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring @InputErrorClass("Input.Password")"
                required />
    </div>
    <p class="text-right mb-6 mt-2">
        <a asp-page="/Account/ForgotPassword" class="text-xs link-secondary underline">Esqueci minha senha</a>
    </p>
    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary">Entrar</button>
    <p class="text-center mt-6 text-xs">
        Não possui uma conta?
        <a asp-page="/Account/Register" class="text-xs link-secondary underline"> Criar conta</a>
    </p>
</form>

@functions {
    public string InputErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "input-error"
            : "";
    }
}