@page "/"
@model myProducts.Pages.Account.LoginModel
@{
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";
}

@section AuthTitle {
            Login
}

<form method="post">
    <div>
        <input type="text"
                id="username"
                name="username"
                placeholder="Usuário"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring"
                required />
    </div>
    <div class="mt-2">
        <input type="password"
                id="password"
                name="password"
                placeholder="Senha"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring"
                required />
    </div>
    <p class="text-right mb-6 mt-2">
        <a asp-page="/Account/ForgotPassword" class="text-xs link-secondary link-secondary underline">Esqueci minha senha</a>
    </p>
    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary">Entrar</button>
    <p class="text-center mt-6 text-xs">
        Não possui uma conta?
        <a asp-page="/Account/Register" class="text-xs link-secondary underline"> Criar conta</a>
    </p>
</form>