@page "/"
@model myProducts.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - myProducts</title>
    <link rel="icon" type="image/x-icon" href="images/Icon.ico">
    <link href="~/css/output.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
</head>
<body class="flex flex-col min-h-screen bg-gray-100 text-gray-800">
    <main class="flex-1 flex items-center justify-center p-4">
        <section class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg overflow-hidden max-w-3xl w-full">
            <div class="w-full md:w-1/2 flex items-center justify-center p-8 login__background order-1 md:order-2">
                <img src="images/Logotipo_branco.png" alt="Logotipo da Loja" class="max-h-40">
            </div>
            <div class="w-full md:w-1/2 p-8 order-2 md:order-1">
                <h2 class="text-2xl font-bold mb-6 text-center">Login</h2>
                <form method="post">
                    <div>
                        <input type="text"
                               id="username"
                               name="username"
                               placeholder="Usuário"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring"
                               required />
                    </div>
                    <div class="mt-2">
                        <input type="password"
                               id="password"
                               name="password"
                               placeholder="Senha"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring"
                               required />
                    </div>
                    <p class="text-right mb-6 mt-2">
                        <a href="#" class="text-xs link-secondary link-secondary underline">Esqueci minha senha</a>
                    </p>
                    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary">Entrar</button>
                    <p class="text-center mt-6 text-xs">
                        Não possui uma conta?
                        <a href="#" class="text-xs link-secondary underline"> Criar conta</a>
                    </p>
                </form>
            </div>
        </section>
    </main>
    <footer class="bg-gray-100 py-1 mt-auto">
        <div class="container mx-auto px-4 text-center">
            <p class="md:text-base login__footer footer__small-text">v1.0</p>
        </div>
    </footer>
</body>
</html>