@page
@model myProducts.Pages.Account.RegisterModel
@{
    Layout = "~/Pages/Shared/Auth/_AuthLayout.cshtml";
    ViewData["Title"] = "Criar conta";
}

@section AuthTitle {
    Cadastro
}

<form method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error">
            <div asp-validation-summary="All"></div>
        </div>
    }
    <div>
        <label asp-for="Input.FullName" class="block text-sm font-medium text-gray-700">Nome completo</label>
        <input asp-for="Input.FullName" type="text" id="fullname" autocomplete="name"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring @InputErrorClass("Input.FullName")"
                required />
    </div>
    <div class="mt-2">
        <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700">E-mail</label>
        <input asp-for="Input.Email" type="email" id="email" autocomplete="email"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring @InputErrorClass("Input.Email")"
                required />
    </div>
    <div class="mt-2">
        <label asp-for="Input.Username" class="block text-sm font-medium text-gray-700">Usuário</label>
        <input asp-for="Input.Username" type="text" id="username" autocomplete="username"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring @InputErrorClass("Input.Username")"
                required />
    </div>
    <div class="mt-2">
        <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700">Senha</label>
        <input asp-for="Input.Password" type="password" id="password" autocomplete="new-password"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring @InputErrorClass("Input.Password")"
                required />
    </div>
    <div class="mt-2 mb-2">
        <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirme a senha</label>
        <input asp-for="Input.ConfirmPassword" type="password" id="repassword" autocomplete="new-password"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring @InputErrorClass("Input.ConfirmPassword")"
                required />
        <p id="password-match" class="text-xs mt-1"></p>
    </div>
    <div class="mt-2">
        <div class="w-full bg-gray-200 rounded-full h-2">
            <div id="password-strength-bar" class="h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <p id="password-strength-text" class="text-xs mt-1"></p>
    </div>
    <ul id="password-requirements" class="mt-2 text-sm space-y-1">
        <li id="req-length" class="text-red-600">Mínimo de 8 caracteres</li>
        <li id="req-upper" class="text-red-600">Pelo menos 1 letra maiúscula</li>
        <li id="req-lower" class="text-red-600">Pelo menos 1 letra minúscula</li>
        <li id="req-number" class="text-red-600">Pelo menos 1 número</li>
        <li id="req-special" class="text-red-600">Pelo menos 1 caractere especial</li>
    </ul>
    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary mt-6">Criar conta</button>
    <p class="text-center mt-6 text-xs">
        Já possui uma conta?
        <a asp-page="/Account/Login" class="text-xs link-secondary underline">Entrar</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account/password-validation.js"></script>
}

@functions {
    public string InputErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "input-error"
            : "";
    }
}