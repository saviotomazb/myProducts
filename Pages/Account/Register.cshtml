@page
@model myProducts.Pages.Account.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta - myProducts</title>
    <link rel="icon" type="image/x-icon" href="~/images/Icon.ico">
    <link href="~/css/output.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
</head>
<body class="flex flex-col min-h-screen bg-gray-100 text-gray-800">
    <main class="flex-1 flex items-center justify-center p-4">
        <section class="flex flex-col md:flex-row bg-white rounded-2xl shadow-lg overflow-hidden max-w-3xl w-full">
            <div class="w-full md:w-1/2 flex items-center justify-center p-8 login__background order-1 md:order-2">
                <img src="~/images/Logotipo_branco.png" alt="Logotipo da Loja" class="max-h-40">
            </div>
            <div class="w-full md:w-1/2 p-8 order-2 md:order-1">
                <h2 class="text-2xl font-bold mb-6 text-center">Cadastro</h2>
                <form method="post">
                    <div>
                        <label for="fullname" class="block text-sm font-medium text-gray-700">Nome completo</label>
                        <input type="text" id="fullname" name="fullname" autocomplete="name"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring"
                               required />
                    </div>
                    <div class="mt-2">
                        <label for="email" class="block text-sm font-medium text-gray-700">E-mail</label>
                        <input type="email" id="email" name="email" autocomplete="email"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring"
                               required />
                    </div>
                    <div class="mt-2">
                        <label for="username" class="block text-sm font-medium text-gray-700">Usuário</label>
                        <input type="text" id="username" name="username" autocomplete="username"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring"
                               required />
                    </div>
                    <div class="mt-2">
                        <label for="passwordhash" class="block text-sm font-medium text-gray-700">Senha</label>
                        <input type="password" id="password" name="password" autocomplete="new-password"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring"
                               required />
                    </div>
                    <div class="mt-2 mb-2">
                        <label for="repasswordhash" class="block text-sm font-medium text-gray-700">Confirme a senha</label>
                        <input type="password" id="repassword" name="repassword" autocomplete="new-password"
                               class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring"
                               required />
                        <p id="password-match" class="text-xs mt-1"></p>
                    </div>
                    <div class="mt-2">
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div id="password-strength-bar" class="h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                        <p id="password-strength-text" class="text-xs mt-1"></p>
                    </div>
                    <ul id="password-requirements" class="mt-2 text-sm space-y-1">
                        <li id="req-length" class="text-red-600">Mínimo de 8 caracteres</li>
                        <li id="req-upper" class="text-red-600">Pelo menos 1 letra maiúscula</li>
                        <li id="req-lower" class="text-red-600">Pelo menos 1 letra minúscula</li>
                        <li id="req-number" class="text-red-600">Pelo menos 1 número</li>
                        <li id="req-special" class="text-red-600">Pelo menos 1 caractere especial</li>
                    </ul>
                    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary mt-6">Criar conta</button>
                    <p class="text-center mt-6 text-xs">
                        Já possui uma conta?
                        <a asp-page="/Account/Login" class="text-xs link-secondary underline">Entrar</a>
                    </p>
                </form>
            </div>
        </section>
    </main>
    <footer class="bg-gray-100 py-1 mt-auto">
        <div class="container mx-auto px-4 text-center">
            <p class="md:text-base login__footer footer__small-text">v1.0</p>
        </div>
    </footer>
    <script src="~/js/password-validation.js"></script>
</body>
</html>