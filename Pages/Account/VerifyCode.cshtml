@page
@model myProducts.Pages.Account.VerifyCodeModel
@{
    Layout = "~/Pages/Shared/Auth/_AuthLayout.cshtml";
    ViewData["Title"] = "Validar código";
}

@section AuthTitle {
    Validar código de segurança
}

<form method="post" role="form" aria-describedby="codigoHelp">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error">
            <div asp-validation-summary="All"></div>
        </div>
    }
    <div class="flex flex-wrap gap-3 justify-center">
        <input type="tel" maxlength="1" inputmode="numeric" name="Input.Digit1"
                class="w-10 h-10 sm:w-12 sm:h-12 text-lg sm:text-xl font-mono text-center rounded-lg border border-gray-300 login__input focus:ring code-input"
                aria-label="Dígito 1" autocomplete="one-time-code" />

        <input type="tel" maxlength="1" inputmode="numeric" name="Input.Digit2"
                class="w-10 h-10 sm:w-12 sm:h-12 text-lg sm:text-xl font-mono text-center rounded-lg border border-gray-300 login__input focus:ring code-input"
                aria-label="Dígito 2" />

        <input type="tel" maxlength="1" inputmode="numeric" name="Input.Digit3"
                class="w-10 h-10 sm:w-12 sm:h-12 text-lg sm:text-xl font-mono text-center rounded-lg border border-gray-300 login__input focus:ring code-input"
                aria-label="Dígito 3" />

        <input type="tel" maxlength="1" inputmode="numeric" name="Input.Digit4"
                class="w-10 h-10 sm:w-12 sm:h-12 text-lg sm:text-xl font-mono text-center rounded-lg border border-gray-300 login__input focus:ring code-input"
                aria-label="Dígito 4" />

        <input type="tel" maxlength="1" inputmode="numeric" name="Input.Digit5"
                class="w-10 h-10 sm:w-12 sm:h-12 text-lg sm:text-xl font-mono text-center rounded-lg border border-gray-300 login__input focus:ring code-input"
                aria-label="Dígito 5" />
    </div>

    <input type="hidden" asp-for="Input.Code" id="hiddenCode" class="@InputErrorClass("Input.Code")" />

    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary mt-6">
        Validar
    </button>
    <p class="text-center mt-6 text-xs">
        Não recebeu o código?
        <a asp-page="/Account/ForgotPassword" class="link-secondary underline">Reenviar</a>
    </p>
</form>

@section Scripts {
    <script src="~/js/account/verify-code.js"></script>
}

@functions {
    public string InputErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "input-error"
            : "";
    }
}