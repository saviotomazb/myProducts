@page
@model myProducts.Pages.Account.ResetPasswordModel
@{
    Layout = "~/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Redefinição de senha";
}

@section AuthTitle {
    Redefinir senha
}

<form method="post">
    @Html.AntiForgeryToken()
    <div>
        <input type="password"
                id="password"
                name="newpassword"
                placeholder="Digite sua nova senha"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring"
                autocomplete="new-password"
                required />
    </div>
    <div class="mt-2">
        <input type="password"
                id="repassword"
                name="confirmnewpassword"
                placeholder="Digite a senha novamente"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm login__input focus:ring"
                autocomplete="new-password"
                required />
        <p id="password-match" class="text-xs mt-1"></p>
    </div>
    <div class="mt-2">
        <div class="w-full bg-gray-200 rounded-full h-2">
            <div id="password-strength-bar" class="h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <p id="password-strength-text" class="text-xs mt-1"></p>
    </div>
    <ul id="password-requirements" class="mt-2 text-sm space-y-1">
        <li id="req-length" class="text-red-600">Mínimo de 8 caracteres</li>
        <li id="req-upper" class="text-red-600">Pelo menos 1 letra maiúscula</li>
        <li id="req-lower" class="text-red-600">Pelo menos 1 letra minúscula</li>
        <li id="req-number" class="text-red-600">Pelo menos 1 número</li>
        <li id="req-special" class="text-red-600">Pelo menos 1 caractere especial</li>
    </ul>
    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary mt-6">Alterar senha</button>
    <p class="text-center mt-6 text-xs">
        <a asp-page="/Account/VerifyCode" class="text-xs link-secondary underline">Voltar para validação do código</a>
    </p>
</form>

@section Scripts {
    <script src="~/js/account/password-validation.js"></script>
}