@page
@model myProducts.Pages.Account.ForgotPasswordModel
@{
    Layout = "~/Pages/Shared/Auth/_AuthLayout.cshtml";
    ViewData["Title"] = "Esqueci minha senha";
}

@section AuthTitle {
        Esqueceu sua senha?
}

<form method="post">
    <div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <div asp-validation-summary="All"></div>
            </div>
        }
        else if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                @TempData["Message"]
            </div>
        }
        <label for="username_email" class="block text-sm font-medium text-gray-700">
            Usuário ou e-mail
        </label>
        <input type="text"
                id="username_email"
                asp-for="Input.User_email"
                autocomplete="username email"
                placeholder="Informe seu usuário ou e-mail cadastrado"
                class="mt-1 block w-full rounded-lg border border-gray-300 p-2 text-sm form__input focus:ring @InputErrorClass("Input.User_email")"
                required />
    </div>
    <button type="submit" class="w-full text-white py-2 rounded-lg transition button--primary mt-6">
        Enviar código de recuperação
    </button>
    <p class="text-center mt-6 text-xs">
        <a asp-page="/Account/Login" class="text-xs link-secondary underline">Voltar ao login</a>
    </p>
</form>

@functions {
    public string InputErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "input-error"
            : "";
    }
}