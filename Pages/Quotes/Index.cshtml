@page
@model myProducts.Pages.Quotes.IndexModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Orçamentos";
}

<div class="pt-16 sm:pt-20 lg:pt-24 px-4 sm:px-6 lg:px-8">
    <div class="pt-8 sm:pt-12 lg:pt-16 pb-8 sm:pb-12 lg:pb-16">

        <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
                <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold mb-2">Orçamentos</h1>
                <p>Preencha os dados abaixo para cadastrar um novo orçamento.</p>
            </div>
            <button class="h-fit shrink-0 text-white p-2 px-6 rounded-lg transition button--primary">Consultar orçamentos</button>
        </div>
        
        <form method="post" class="shadow bg-white rounded-lg mt-6 p-6">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-4 mt-2 text-green-600 text-xs text-center sm:text-left" id="success-message">@TempData["SuccessMessage"]</div>
                }
                <section class="border-b border-gray-200 pb-6 mb-6">
                <div class="text-sm font-semibold text-gray-700 mb-4">
                        <span>Pedido:<span></span></span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">Cliente:</label>
                            <input type="text" class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" placeholder="Selecione ou informe o cliente" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Responsável:</label>
                            <input type="text" class="w-full p-2 rounded-lg border border-gray-300 bg-gray-100 text-gray-400 text-sm cursor-not-allowed focus:ring login__input" 
                            value="Usuário logado" disabled />
                        </div>
                    </div>
                </section>
                <section class="border-b border-gray-200 pb-6 mb-6">
                    <h2 class="text-sm font-semibold text-gray-700 mb-4">Itens do orçamento</h2>
                        <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">Produto:</label>
                                <input type="text" class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                                placeholder="Selecione o produto"/>
                            </div>
                            <div class="w-full sm:w-28">
                                <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">Quantidade:</label>
                                <input type="number" class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" 
                                min="1"/>
                            </div>
                            <div class="w-full sm:w-40">
                                <label class="block text-sm font-medium text-gray-700 mb-1">Valor unitário:</label>
                                <input type="text" class="w-full p-2 rounded-lg border border-gray-300 bg-gray-100 text-sm cursor-not-allowed focus:ring login__input" 
                                disabled placeholder="R$0,00"/>
                            </div>
                            <button type="button" class="mt-6 sm:mt-6 h-fit shrink-0 text-white p-2 px-6 rounded-lg transition button--primary">Adicionar</button>
                        </div>
                </section>
                <section class="border-b border-gray-200 pb-6 mb-6">
                    <h2 class="text-sm font-semibold text-gray-700 mb-4">Produtos adicionados</h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm border border-gray-200 rounded-lg">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="text-left p-2">Produto</th>
                                    <th class="text-center p-2">Quantidade</th>
                                    <th class="text-right p-2">Valor</th>
                                    <th class="text-right p-2">Subtotal</th>
                                    <th class="text-center p-2">Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="p-2">Produto exemplo</td>
                                    <td class="text-center p-2">2</td>
                                    <td class="text-right p-2">R$ 50,00</td>
                                    <td class="text-right p-2 font-medium">R$ 100,00</td>
                                    <td class="text-center p-2">
                                    <button class="link--danger text-xs">
                                            Remover
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="flex justify-end mt-4">
                        <div class="text-right">
                            <p class="text-sm text-gray-600">Total</p>
                            <p class="text-lg font-semibold">R$100,00</p>
                        </div>
                    </div>
                </section>
                <section>
                    <h2 class="text-sm font-semibold text-gray-700 mb-4">Finalização</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Validade do orçamento:</label>
                            <input type="date" class="w-full sm:w-60 p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Observações:</label>
                        <textarea rows="3" class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input resize-none"></textarea>
                    </div>
                    <div class="flex justify-center sm:justify-end">
                    <button type="submit" class="w-full sm:w-auto h-fit shrink-0 text-white p-2 px-6 rounded-lg transition button--success">Cadastrar orçamento</button>
                    </div>
                </section>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const msg = document.getElementById('success-message');
        if (msg) {
            setTimeout(() => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 500);

            }, 4000);
        }
    });
</script>