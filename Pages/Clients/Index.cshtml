@page
@model myProducts.Pages.Clients.IndexModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Clientes";
}

<div class="pt-16 sm:pt-20 lg:pt-24 px-4 sm:px-6 lg:px-8">
    <div class="pt-8 sm:pt-12 lg:pt-16 pb-8 sm:pb-12 lg:pb-16">

        <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
                <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold mb-2">Clientes</h1>
                <p>Preencha os dados abaixo para cadastrar um novo cliente.</p>
            </div>
            <button class="h-fit shrink-0 text-white p-2 px-6 rounded-lg transition button--primary cursor-pointer">Consultar clientes</button>
        </div>

        <form method="post" class="shadow bg-white rounded-lg mt-6 p-6">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 mt-2 text-green-600 text-xs text-center sm:text-left" id="success-message">@TempData["SuccessMessage"]</div>
            }

            <section class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Nome completo:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite o nome completo do cliente" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Número de telefone:
                        </label>
                        <input type="text"
                               id="phone"
                               maxlength="15"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="(00) 00000-0000" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr] gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Cidade:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite a cidade" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Estado
                        </label>
                        <select class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input text-gray-400" id="state">
                            <option value="" disabled selected>Selecione</option>
                            <option value="AC">AC</option>
                            <option value="AL">AL</option>
                            <option value="AP">AP</option>
                            <option value="AM">AM</option>
                            <option value="BA">BA</option>
                            <option value="CE">CE</option>
                            <option value="DF">DF</option>
                            <option value="ES">ES</option>
                            <option value="GO">GO</option>
                            <option value="MA">MA</option>
                            <option value="MT">MT</option>
                            <option value="MS">MS</option>
                            <option value="MG">MG</option>
                            <option value="PA">PA</option>
                            <option value="PB">PB</option>
                            <option value="PR">PR</option>
                            <option value="PE">PE</option>
                            <option value="PI">PI</option>
                            <option value="RJ">RJ</option>
                            <option value="RN">RN</option>
                            <option value="RS">RS</option>
                            <option value="RO">RO</option>
                            <option value="RR">RR</option>
                            <option value="SC">SC</option>
                            <option value="SP">SP</option>
                            <option value="SE">SE</option>
                            <option value="TO">TO</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr] gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Rua:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite a rua" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Número:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite o número" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Bairro:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite o bairro" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Complemento:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Apartamento, bloco, referência..." />
                    </div>
                </div>

                <div class="flex justify-center sm:justify-end pt-2">
                    <button type="submit"
                            class="w-full sm:w-auto text-white p-2 px-6 rounded-lg transition bg-green-500 hover:bg-green-600 cursor-pointer">
                        Cadastrar cliente
                    </button>
                </div>
            </section>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const msg = document.getElementById('success-message');
        if (msg) {
            setTimeout(() => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 500);
            }, 4000);
        }

        const phoneInput = document.getElementById('phone');

        if (phoneInput) {
            phoneInput.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 11) value = value.slice(0, 11);

                if (value.length > 10) {
                    value = value.replace(/^(\d{2})(\d{5})(\d{0,4}).*/, '($1) $2-$3');
                } else if (value.length > 6) {
                    value = value.replace(/^(\d{2})(\d{4})(\d{0,4}).*/, '($1) $2-$3');
                } else if (value.length > 2) {
                    value = value.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
                } else if (value.length > 0) {
                    value = value.replace(/^(\d*)/, '($1');
                }

                e.target.value = value;
            });
        }

        const stateSelect = document.getElementById('state');

        if (stateSelect) {
            stateSelect.addEventListener('change', function() {
                if (this.value) {
                    this.classList.remove('text-gray-400');
                    this.classList.add('text-gray-700');
                } else {
                    this.classList.remove('text-gray-700');
                    this.classList.add('text-gray-400');
                }
            });
        }
    });
</script>