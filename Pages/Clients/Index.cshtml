@page
@model myProducts.Pages.Clients.IndexModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Clientes";
}

<div class="pt-16 sm:pt-20 lg:pt-24 px-4 sm:px-6 lg:px-8">
    <div class="pt-8 sm:pt-12 lg:pt-16 pb-8 sm:pb-12 lg:pb-16">

        <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
                <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold mb-2">Clientes</h1>
                <p>Preencha os dados abaixo para cadastrar um novo cliente.</p>
            </div>
            <button class="h-fit shrink-0 text-white p-2 px-6 rounded-lg transition button--primary cursor-pointer">Consultar clientes</button>
        </div>

        <form method="post" class="shadow bg-white rounded-lg mt-6 p-6">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 mt-2 text-green-600 text-xs text-center sm:text-left" id="success-message">@TempData["SuccessMessage"]</div>
            }

            <section class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col">
                        <span asp-validation-for="Input.FullName" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1 after:content-['*'] after:ml-1 after:text-red-500">
                            Nome completo:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite o nome completo do cliente" 
                               asp-for="Input.FullName" />
                    </div>

                    <div class="flex flex-col">
                        <span asp-validation-for="Input.PhoneNumber" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Número de telefone:
                        </label>
                        <input type="text"
                               id="phone"
                               maxlength="15"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="(00) 00000-0000"
                               asp-for="Input.PhoneNumber" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr] gap-4">
                    <div class="flex flex-col">
                        <span asp-validation-for="Input.City" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Cidade:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite a cidade" 
                               asp-for="Input.City" />
                    </div>

                    <div class="flex flex-col">
                        <span asp-validation-for="Input.State" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1" asp-for="Input.State">
                            Estado
                        </label>
                        <select class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input text-gray-400" id="state" asp-for="Input.State" asp-items="Model.States">
                            
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr] gap-4">
                    <div class="flex flex-col">
                        <span asp-validation-for="Input.Street" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Rua:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite a rua"
                               asp-for="Input.Street" />
                    </div>

                    <div class="flex flex-col">
                        <span asp-validation-for="Input.HouseNumber" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Número:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite o número" 
                               asp-for="Input.HouseNumber" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col">
                        <span asp-validation-for="Input.District" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Bairro:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Digite o bairro"
                               asp-for="Input.District" />
                    </div>

                    <div class="flex flex-col">
                        <span asp-validation-for="Input.Complement" class="text-red-600 text-xs sm:text-left mb-1 min-h-[16px]"></span>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Complemento:
                        </label>
                        <input type="text"
                               class="w-full p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"
                               placeholder="Apartamento, bloco, referência..." 
                               asp-for="Input.Complement" />
                    </div>
                </div>

                <div class="flex justify-center sm:justify-end pt-2">
                    <button type="submit"
                            class="w-full sm:w-auto text-white p-2 px-6 rounded-lg transition bg-green-500 hover:bg-green-600 cursor-pointer">
                        Cadastrar cliente
                    </button>
                </div>
            </section>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const msg = document.getElementById('success-message');
        if (msg) {
            setTimeout(() => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 500);
            }, 4000);
        }

        const phoneInput = document.getElementById('phone');

        if (phoneInput) {

            phoneInput.addEventListener('input', function (e) {
                let value = e.target.value.replace(/\D/g, '');

                if (value.length > 11) value = value.slice(0, 11);

                if (value.length > 10) {
                    value = value.replace(/^(\d{2})(\d{5})(\d{0,4}).*/, '($1) $2-$3');
                } else if (value.length > 6) {
                    value = value.replace(/^(\d{2})(\d{4})(\d{0,4}).*/, '($1) $2-$3');
                } else if (value.length > 2) {
                    value = value.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
                } else if (value.length > 0) {
                    value = value.replace(/^(\d*)/, '($1');
                }

                e.target.value = value;
            });

            phoneInput.addEventListener('blur', function () {
                if (this.value.length < 14) {
                    this.value = '';
                }
            });
        }

        const stateSelect = document.getElementById('state');

        if (stateSelect) {

            function updateStateColor() {
                if (stateSelect.value) {
                    stateSelect.classList.remove('text-gray-400');
                    stateSelect.classList.add('text-gray-700');
                } else {
                    stateSelect.classList.remove('text-gray-700');
                    stateSelect.classList.add('text-gray-400');
                }
            }

            stateSelect.addEventListener('change', updateStateColor);

            updateStateColor();
        }
    });
</script>