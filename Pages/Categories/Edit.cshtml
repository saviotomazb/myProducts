@page "{id:int?}"
@model myProducts.Pages.Categories.EditModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Editar categoria";
}

<div class="
            pt-16 sm:pt-20 lg:pt-24
            px-4 sm:px-6 lg:px-8
            ">
    <div class="
                pt-8 sm:pt-12 lg:pt-16
                pb-8 sm:pb-12 lg:pb-16
                ">

        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col items-start text-left sm:items-start sm:text-left">
                <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold mb-2">Editar categoria</h1>
                <p>Edite e atualize os dados da categoria selecionada.</p>
            </div>
        </div>

        <form method="post" class="shadow bg-white rounded-lg mt-6 p-6">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">
                    <div asp-validation-summary="All"></div>
                </div>
            }
            <input type="hidden" asp-for="CategoryVM.Id" />
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4 w-full">
                <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-2 w-full">
                        <label for="Nome" class="text-sm font-medium text-gray-700 whitespace-nowrap mb-2 sm:mb-0 sm:mr-2">Nome da categoria:</label>
                        <input type="text" asp-for="CategoryVM.Name" placeholder="Insira o novo nome" class="w-full flex-grow sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm login__input focus:ring @InputErrorClass("CategoryVM.Name")" />
                </div>
                <div class="flex items-center space-x-2">
                    <label for="Ativa" class="text-sm font-medium text-gray-500">Ativo?</label>
                    <input asp-for="CategoryVM.IsActive" type="checkbox" class="h-4 w-4 border-gray-300"/>
                </div>
            </div>
            <div class="text-sm text-gray-500 space-y-1 mt-4 text-left sm:text-left mx-auto sm:mx-0">
                <p>Criado em: @Model.CategoryVM.CreatedAtFormatted</p>
                <p>Última modificação: @Model.CategoryVM.LastModifiedFormatted</p>
            </div>
            <div class="flex items-center gap-3 mt-6">
                <button type="submit" class="text-white px-5 py-2 rounded-lg bg-green-500 hover:bg-green-600">Salvar</button>
                <a asp-page="/Categories/Index" class="text-xs link-secondary underline">Cancelar</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const msg = document.getElementById('success-message');
        if (msg) {
            setTimeout(() => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 500);

            }, 3000);
        }
    });
</script>

@functions {
    public string InputErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "input-error"
            : "";
    }
}