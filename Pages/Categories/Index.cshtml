@page
@model myProducts.Pages.Categories.IndexModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Categorias";
}

<div class="
            pt-16 sm:pt-20 lg:pt-24 
            px-4 sm:px-6 lg:px-8
            ">
    <div class="
                pt-8 sm:pt-12 lg:pt-16
                pb-8 sm:pb-12 lg:pb-16
                ">
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
                <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold mb-2">Categorias</h1>
                <p>Preencha os dados abaixo para cadastrar uma nova categoria.</p>
            </div>
        </div>
        <form method="post" class="shadow bg-white rounded-lg mb-12 p-6">
            <h2 class="text-lg font-semibold mb-4 text-center sm:text-left">Cadastrar nova categoria</h2>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div id="success-message" class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4">
                <label for="Nome" class="text-sm font-medium text-gray-700 mb-2 sm:mb-0 sm:mr-2 after:content-['*'] after:ml-1 after:text-red-500">Nome da categoria:</label>
                <input type="text" asp-for="Input.Name" placeholder="Insira o nome que deseja cadastrar" class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input @InputErrorClass("Input.Name") mb-2 sm:mb-0" />
                <button type="submit" class="text-white p-2 px-6 rounded-lg transition button--success">Cadastrar categoria</button>
            </div>
        </form>
        <form method="get" class="shadow bg-white rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4 text-center sm:text-left">Buscar categoria</h2>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4 mb-4">
                <label for="Nome" class="text-sm font-medium text-gray-700 mb-2 sm:mb-0">Nome:</label>
                <input type="text" asp-for="SearchCategory" value="@Model.SearchCategory" placeholder="Procure o nome da categoria" class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" />
                <button type="submit" class="text-white p-2 px-6 rounded-lg transition button--primary mt-2 sm:mt-0">Buscar</button>
            </div>
            <div class="overflow-x-auto">
                @if (!Model.CategoriesVM.Any())
                {
                    <div class="flex justify-center items-center min-h-24">
                        <p class="text-gray-500 text-xs">Nenhuma categoria encontrada.</p>
                    </div>
                }
                else
                {
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead class="bg-gray-100">
                            <tr class="text-left font-medium text-gray-500 text-uppercase tracking-wider text-xs sm:text-sm">
                                <th class="px-3 sm:px-6 py-4">Nome da categoria</th>
                                <th class="px-3 sm:px-6 py-4">Data da criação</th>
                                <th class="px-3 sm:px-6 py-4">Data da última modificação</th>
                                <th class="px-3 sm:px-6 py-4">Ações</th>
                                <th class="px-3 sm:px-6 py-4">Ativo?</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-300">
                            @foreach (var i in Model.CategoriesVM)
                            {
                                <tr class="hover:bg-gray-100 text-left">
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.Name</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.CreatedAtFormatted</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.LastModifiedFormatted</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate space-x-2">
                                        <a class="link--primary" asp-page="/Categories/Edit" asp-route-id="@i.Id">Editar</a>
                                        <a class="link--danger">Excluir</a>
                                    </td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.IsActiveFormatted</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Model.TotalPages > 1)
                {
                    <div class="flex justify-center mt-4">
                        <a class="px-4 py-2 bg-gray-200 rounded disabled:opacity-50 cursor-not-allowed"
                        href="?SearchCategory=@Model.SearchCategory&PageNumber=@(Model.PageNumber - 1)" @(Model.PageNumber == 1 ? "disabled" : "")>Anterior</a>
                        <span class="px-4 py-2 text-gray-500">Página @Model.PageNumber de @Model.TotalPages</span>
                        <a class="px-4 py-2 bg-gray-200 rounded disabled:opacity-50 cursor-not-allowed"
                           href="?SearchCategory=@Model.SearchCategory&PageNumber=@(Model.PageNumber + 1)" @(Model.PageNumber == Model.TotalPages ? "disabled" : "")>Próximo</a>
                    </div>
                }
            </div>
        </form>   
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const msg = document.getElementById('success-message');
        if (msg) {
            setTimeout(() => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 500);

            }, 3000);
        }
    });
</script>

@functions {
    public string InputErrorClass(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0
            ? "input-error"
            : "";
    }
}