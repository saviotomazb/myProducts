@page
@model myProducts.Pages.Products.IndexModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Produtos";
}

<div class="
            pt-16 sm:pt-20 lg:pt-24
            px-4 sm:px-6 lg:px-8
            ">
    <div class="
                pt-8 sm:pt-12 lg:pt-16
                pb-8 sm:pb-12 lg:pb-16
                ">
        <div class="flex items-center justify-center mb-6">
            <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold">Produtos</h1>
        </div>
        <form method="post" class="shadow bg-white rounded-lg mb-12 p-6">
            <h2 class="text-lg font-semibold mb-4 text-center sm:text-left">Cadastrar novo produto</h2>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mb-4 mt-2 text-green-600 text-xs text-center sm:text-left" id="success-message">@TempData["SuccessMessage"]</div>
            }
            <span asp-validation-for="Input.Name" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4">
                <label class="sm:w-32 text-sm font-medium text-gray-700 mb-2 sm:mb-0 after:content-['*'] after:ml-1 after:text-red-500">Nome do produto:</label>
                <input type="text" asp-for="Input.Name" placeholder="Insira o nome que deseja cadastrar" 
                class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" />
            </div>
            <span asp-validation-for="Input.Description" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4">
                <label class="sm:w-32 text-sm font-medium text-gray-700 mb-2 sm:mb-0">Descrição:</label>
                <textarea asp-for="Input.Description" placeholder="Insira uma descrição" 
                class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"></textarea>
            </div>
            <span asp-validation-for="Input.CategoryId" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4 sm:mb-4 mb-0">
                <label class="sm:w-32 text-sm font-medium text-gray-700 mb-2 sm:mb-0 after:content-['*'] after:ml-1 after:text-red-500">Categoria:</label>
                <select asp-for="Input.CategoryId" asp-items="Model.CategoriesList" 
                class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input">
                    <option value="">Selecione</option>
                </select>
            </div>
            <div class="flex flex-col items-center sm:flex-row mt-2 sm:mt-0">
                <button type="submit" class="text-white p-2 px-6 rounded-lg transition bg-green-500 hover:bg-green-600 cursor-pointer">Cadastrar</button>
            </div>
        </form>
        <form method="get" class="shadow bg-white rounded-lg p-6">
            <h2 class="text-lg font-semibold mb-4 text-center sm:text-left">Buscar produto</h2>
            <span asp-validation-for="SearchProduct" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4 mb-4">
                <label for="Nome" class="text-sm font-medium text-gray-700 mb-2 sm:mb-0">Nome:</label>
                <input type="text" asp-for="SearchProduct" value="@Model.SearchProduct" placeholder="Procure o nome da categoria" class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" />
                <button type="submit" class="text-white p-2 px-6 rounded-lg transition button--primary mt-2 sm:mt-0">Buscar</button>
            </div>
            <div class="overflow-x-auto">
                @if (!Model.ProductsVM.Any())
                {
                    <div class="flex justify-center items-center min-h-24">
                        <p class="text-gray-500 text-xs">Nenhum produto encontrado.</p>
                    </div>
                }
                else
                {
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead class="bg-gray-100">
                            <tr class="text-left font-medium text-gray-500 text-uppercase tracking-wider text-xs sm:text-sm">
                                <th class="px-3 sm:px-6 py-4">Nome do produto</th>
                                <th class="px-3 sm:px-6 py-4">Categoria</th>
                                <th class="px-3 sm:px-6 py-4">Data da criação</th>
                                <th class="px-3 sm:px-6 py-4">Data da última modificação</th>
                                <th class="px-3 sm:px-6 py-4">Ações</th>
                                <th class="px-3 sm:px-6 py-4">Ativa?</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-300">
                            @foreach (var i in Model.ProductsVM)
                            {
                                <tr class="hover:bg-gray-100 text-left">
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.Name</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.CategoryName</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.CreatedAtFormatted</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.LastModifiedFormatted</td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate space-x-2">
                                        <a class="text-blue-500 hover:text-blue-700 cursor-pointer" asp-page="/Products/Edit" asp-route-id="@i.ProductId">Editar</a>
                                        <a class="text-blue-500 hover:text-blue-700 cursor-pointer">Excluir</a>
                                    </td>
                                    <td class="px-3 sm:px-6 py-4 whitespace-nowrap text-truncate">@i.IsActiveFormatted</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Model.TotalPages > 1)
                {
                    <div class="flex justify-center mt-4">
                        <a class="px-4 py-2 bg-gray-200 rounded disabled:opacity-50 cursor-not-allowed"
                           href="?SearchCategory=@Model.ProductsVM&PageNumber=@(Model.PageNumber - 1)" @(Model.PageNumber == 1 ? "disabled" : "")>Anterior</a>
                        <span class="px-4 py-2 text-gray-500">Página @Model.PageNumber de @Model.TotalPages</span>
                        <a class="px-4 py-2 bg-gray-200 rounded disabled:opacity-50 cursor-not-allowed"
                           href="?SearchCategory=@Model.ProductsVM&PageNumber=@(Model.PageNumber + 1)" @(Model.PageNumber == Model.TotalPages ? "disabled" : "")>Próximo</a>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const msg = document.getElementById('success-message');
        if (msg) {
            setTimeout(() => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 500);

            }, 4000);
        }
    });
</script>