@page "{id:int?}"
@model myProducts.Pages.Products.EditModel
@{
    Layout = "~/Pages/Shared/App/_MainLayout.cshtml";
    ViewData["Title"] = "Editar produto";
}

<div class="
            pt-16 sm:pt-20 lg:pt-24
            px-4 sm:px-6 lg:px-8
            ">
    <div class="
                pt-8 sm:pt-12 lg:pt-16
                pb-8 sm:pb-12 lg:pb-16
                ">
        <div class="flex items-center justify-center mb-6">
            <h1 class="text-xl sm:text-1xl lg:text-2xl font-bold">Editar produto</h1>
        </div>
        <form method="post" class="shadow bg-white rounded-lg p-6">
            <input type="hidden" asp-for="ProductVM.ProductId" />
            <span asp-validation-for="ProductVM.Name" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4">
                <label class="sm:w-32 text-sm font-medium text-gray-700 mb-2 sm:mb-0 after:content-['*'] after:ml-1 after:text-red-500">Nome do produto:</label>
                <input type="text" asp-for="ProductVM.Name" placeholder="Insira o nome que deseja salvar"
                       class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input" />
            </div>
            <span asp-validation-for="ProductVM.Description" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4">
                <label class="sm:w-32 text-sm font-medium text-gray-700 mb-2 sm:mb-0">Descrição:</label>
                <textarea asp-for="ProductVM.Description" placeholder="Insira uma descrição"
                          class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input"></textarea>
            </div>
            <span asp-validation-for="ProductVM.CategoryId" class="block w-full text-red-600 text-xs text-center sm:text-left mb-2"></span>
            <div class="flex flex-col items-center sm:flex-row sm:space-x-4 sm:mb-4 mb-0">
                <label class="sm:w-32 text-sm font-medium text-gray-700 mb-2 sm:mb-0 after:content-['*'] after:ml-1 after:text-red-500">Categoria:</label>
                <select asp-for="ProductVM.CategoryId" asp-items="Model.ProductsList"
                        class="w-full sm:flex-grow sm:max-w-5xl p-2 rounded-lg border border-gray-300 text-sm focus:ring login__input">
                    <option value="">Selecione</option>
                </select>
            </div>

            <div class="text-sm text-gray-500 space-y-1 mt-4 text-center sm:text-left mx-auto sm:mx-0">
                <p>Criado em: @Model.ProductVM.CreatedAtFormatted</p>
                <p>Última modificação: @Model.ProductVM.LastModifiedFormatted</p>
            </div>
            <div class="flex flex-col sm:flex-row items-center sm:space-x-4 mt-4">
                <button type="submit" class="text-white p-2 px-6 rounded-lg transition bg-green-500 hover:bg-green-600 cursor-pointer mt-2 sm:mt-0">Salvar</button>
                <a asp-page="/Products/Index" class="text-xs link-secondary underline mt-2 sm:mt-0">Cancelar</a>
            </div>
        </form>
    </div>
</div>