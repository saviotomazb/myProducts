@using System.Security.Claims

@*
    Navbar e menu lateral
*@

@{
    var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? "Usuário";
    var firstName = fullName.Split(' ')[0];
    var displayName = firstName.Length > 10 ? firstName.Substring(0, 10) + "..." : firstName;
}

<nav class="
                bg-white
                shadow-md
                fixed
                w-full
                top-0
                z-50
                h-16
                sm:h-20 lg:h-24
                flex
                items-center
                justify-between
                px-4 sm:px-6 lg:px-8
                ">
    <div class="flex items-center mr-4 sm:mr-6 lg:mr-8">
        <input type="checkbox" id="menu-toggle" class="hidden peer" />
        <label for="menu-toggle" class="cursor-pointer">
            <svg class="h-6 w-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </label>
        <div class="
                        fixed
                        top-16 sm:top-20 lg:top-24
                        left-0
                        w-56 sm:w-64 md:w-72
                        h-screen
                        bg-white
                        shadow-md
                        transform -translate-x-full peer-checked:translate-x-0 transition-transform
                        duration-200
                        z-50
                        shadow-lg
                        ">
            <ul class="p-4 space-y-3">
                <li><a asp-page="/Home/Index" class="block text-gray-700 link__navbar">Início</a></li>
                <li><a asp-page="/Categories/Index" class="block text-gray-700 link__navbar">Categorias</a></li>
                <li><a asp-page="/Dashboard/Index" class="block text-gray-700 link__navbar">Dashboards</a></li>
                <li><a asp-page="/Quotes/Index" class="block text-gray-700 link__navbar">Orçamentos</a></li>
                <li><a asp-page="/Products/Index" class="block text-gray-700 link__navbar">Produtos</a></li>
            </ul>
        </div>
    </div>
    <div class="absolute left-1/2 transform -translate-x-1/2 flex items-center z-10">
        <a asp-page="/Home/Index" class="text-xl font-semibold text-gray-800">
            <img src="~/images/Logotipo.png" alt="Logo" class="h-8 inline-block">
        </a>
    </div>
    <div class="flex items-center ml-auto space-x-4">
        <span class="hidden md:inline text-gray-800">Olá, <strong>@displayName</strong></span>
        <a asp-page="/Account/Logout" class="text-red-600 hover:text-red-700 transition-colors rounded-full" title="Sair">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4m-6-8h10m-4-4l4 4-4 4" />
            </svg>
        </a>
    </div>
</nav>