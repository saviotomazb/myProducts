@*
    Layout para tela de erro
*@

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - myProducts</title>
    <link rel="icon" type="image/x-icon" href="~/images/Icon.ico">
    <link href="~/css/output.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
</head>
<body class="flex flex-col items-center justify-center min-h-screen bg-gray-50 px-4 text-center">
    <div class="flex flex-col items-center justify-center min-h-screen px-4 text-center max-w-sm mx-auto">
        @RenderBody()
    </div>
</body>
</html>